{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgentManifest",
  "type": "object",
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "properties": {
    "apiVersion": {
      "type": "string"
    },
    "kind": {
      "const": "Agent"
    },
    "metadata": {
      "type": "object",
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "owner": {
          "type": "string"
        }
      }
    },
    "spec": {
      "type": "object",
      "required": [
        "profile"
      ],
      "properties": {
        "profile": {
          "type": "object"
        },
        "instructions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "guidanceFiles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "skills": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "commands": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "policies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "hooks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "workflow": {
          "type": "string"
        },
        "knowledgeScopes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "memoryScopes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "modelPolicy": {
          "type": "string"
        },
        "evidenceModel": {
          "type": "string"
        },
        "evalProfile": {
          "type": "string"
        }
      }
    }
  }
}
