    },
    "spec": {
      "$ref": "#/$defs/CapabilitySpec"
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "title": "CapabilityContractManifest",
  "type": "object"
