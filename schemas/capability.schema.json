  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "const": "agents.platform/v1",
      "title": "Apiversion",
      "type": "string"
    },
    "kind": {
      "const": "CapabilityContract",
      "title": "Kind",
      "type": "string"
    },
    "metadata": {
