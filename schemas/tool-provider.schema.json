        "endpoint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Endpoint"
        },
        "outputSanitization": {
          "$ref": "#/$defs/ToolProviderOutputSanitization"
        },
        "protocol": {
          "title": "Protocol",
          "type": "string"
        },
        "tenantScope": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
