      "required": [
        "protocol",
        "capabilities"
      ],
      "title": "ToolProviderSpec",
      "type": "object"
    },
    "VersionedMetadata": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "labels": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Labels",
          "type": "object"
