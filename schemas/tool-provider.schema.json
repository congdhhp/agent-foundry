{
  "$defs": {
    "RiskLevel": {
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "title": "RiskLevel",
      "type": "string"
    },
    "ToolProviderCapability": {
      "additionalProperties": false,
      "properties": {
        "contract": {
          "title": "Contract",
          "type": "string"
        },
        "riskLevel": {
          "$ref": "#/$defs/RiskLevel"
        },
        "tool": {
          "title": "Tool",
          "type": "string"
        }
      },
      "required": [
        "contract",
        "tool",
        "riskLevel"
      ],
      "title": "ToolProviderCapability",
      "type": "object"
    },
    "ToolProviderOutputSanitization": {
      "additionalProperties": false,
      "properties": {
        "maxPayloadBytes": {
          "default": 1000000,
          "title": "Maxpayloadbytes",
          "type": "integer"
        },
        "redactSecrets": {
          "default": true,
          "title": "Redactsecrets",
          "type": "boolean"
        },
        "tagUntrusted": {
          "default": true,
          "title": "Taguntrusted",
          "type": "boolean"
        }
      },
      "title": "ToolProviderOutputSanitization",
      "type": "object"
    },
    "ToolProviderSpec": {
      "additionalProperties": false,
      "properties": {
        "authProfile": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Authprofile"
        },
        "capabilities": {
          "items": {
            "$ref": "#/$defs/ToolProviderCapability"
