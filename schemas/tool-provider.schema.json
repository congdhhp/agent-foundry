  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "const": "agents.platform/v1",
      "title": "Apiversion",
      "type": "string"
    },
    "kind": {
      "const": "ToolProvider",
      "title": "Kind",
      "type": "string"
    },
    "metadata": {
      "$ref": "#/$defs/VersionedMetadata"
    },
    "spec": {
      "$ref": "#/$defs/ToolProviderSpec"
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "title": "ToolProviderManifest",
  "type": "object"
}
