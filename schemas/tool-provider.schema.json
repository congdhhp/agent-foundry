{
  "$defs": {
    "RiskLevel": {
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "title": "RiskLevel",
      "type": "string"
    },
    "ToolProviderCapability": {
      "additionalProperties": false,
      "properties": {
        "contract": {
          "title": "Contract",
          "type": "string"
        },
        "riskLevel": {
          "$ref": "#/$defs/RiskLevel"
        },
        "tool": {
          "title": "Tool",
          "type": "string"
        }
      },
      "required": [
        "contract",
        "tool",
        "riskLevel"
      ],
      "title": "ToolProviderCapability",
      "type": "object"
    },
    "ToolProviderHealthCheck": {
      "additionalProperties": false,
      "properties": {
        "command": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Command"
        },
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "mode": {
          "default": "configuration",
          "title": "Mode",
          "type": "string"
        }
      },
      "title": "ToolProviderHealthCheck",
      "type": "object"
    },
    "ToolProviderOutputSanitization": {
      "additionalProperties": false,
      "properties": {
        "maxPayloadBytes": {
          "default": 1000000,
          "title": "Maxpayloadbytes",
          "type": "integer"
        },
        "redactSecrets": {
          "default": true,
          "title": "Redactsecrets",
          "type": "boolean"
        },
        "tagUntrusted": {
          "default": true,
          "title": "Taguntrusted",
          "type": "boolean"
        }
      },
      "title": "ToolProviderOutputSanitization",
      "type": "object"
    },
    "ToolProviderProtocol": {
      "enum": [
        "in_process",
        "mcp",
        "http"
      ],
      "title": "ToolProviderProtocol",
      "type": "string"
    },
    "ToolProviderRuntimeControls": {
      "additionalProperties": false,
      "properties": {
        "allowNetwork": {
          "default": false,
          "title": "Allownetwork",
          "type": "boolean"
        },
        "allowedDomains": {
          "items": {
            "type": "string"
          },
          "title": "Alloweddomains",
          "type": "array"
        },
        "rateLimitPerMinute": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ratelimitperminute"
        },
        "timeoutSeconds": {
          "default": 30,
          "minimum": 1,
          "title": "Timeoutseconds",
          "type": "integer"
        }
      },
      "title": "ToolProviderRuntimeControls",
      "type": "object"
    },
    "ToolProviderSpec": {
      "additionalProperties": false,
      "properties": {
        "authProfile": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Authprofile"
        },
        "capabilities": {
          "items": {
            "$ref": "#/$defs/ToolProviderCapability"
          },
          "title": "Capabilities",
          "type": "array"
        },
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "endpoint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Endpoint"
        },
        "healthCheck": {
          "$ref": "#/$defs/ToolProviderHealthCheck"
        },
        "outputSanitization": {
          "$ref": "#/$defs/ToolProviderOutputSanitization"
        },
        "protocol": {
          "$ref": "#/$defs/ToolProviderProtocol"
        },
        "runtimeControls": {
          "$ref": "#/$defs/ToolProviderRuntimeControls"
        },
        "tenantScope": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tenantscope"
        },
        "transport": {
          "$ref": "#/$defs/ToolProviderTransport",
          "default": "local"
        }
      },
      "required": [
        "protocol",
        "capabilities"
      ],
      "title": "ToolProviderSpec",
      "type": "object"
    },
    "ToolProviderTransport": {
      "enum": [
        "local",
        "stdio",
        "http"
      ],
      "title": "ToolProviderTransport",
      "type": "string"
    },
    "VersionedMetadata": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "labels": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Labels",
          "type": "object"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "owner": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Owner"
        },
        "version": {
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "title": "VersionedMetadata",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "const": "agents.platform/v1",
      "title": "Apiversion",
      "type": "string"
    },
    "kind": {
      "const": "ToolProvider",
      "title": "Kind",
      "type": "string"
    },
    "metadata": {
      "$ref": "#/$defs/VersionedMetadata"
    },
    "spec": {
      "$ref": "#/$defs/ToolProviderSpec"
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "title": "ToolProviderManifest",
  "type": "object"
}
