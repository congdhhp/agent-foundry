{
  "$defs": {
    "PolicyDecision": {
      "enum": [
        "allow",
        "require_approval",
        "deny",
        "require_transform",
        "require_step_up_auth"
      ],
      "title": "PolicyDecision",
      "type": "string"
    },
    "PolicyRule": {
      "additionalProperties": false,
      "properties": {
        "approvers": {
          "items": {
            "type": "string"
          },
          "title": "Approvers",
          "type": "array"
        },
        "decision": {
          "$ref": "#/$defs/PolicyDecision"
        },
        "match": {
          "additionalProperties": true,
          "title": "Match",
          "type": "object"
        },
        "transforms": {
          "items": {
            "type": "string"
          },
          "title": "Transforms",
          "type": "array"
        }
      },
      "required": [
        "match",
        "decision"
      ],
      "title": "PolicyRule",
      "type": "object"
    },
    "PolicySpec": {
      "additionalProperties": false,
      "properties": {
        "rules": {
          "items": {
            "$ref": "#/$defs/PolicyRule"
          },
          "title": "Rules",
          "type": "array"
        }
      },
      "required": [
        "rules"
      ],
      "title": "PolicySpec",
      "type": "object"
    },
    "VersionedMetadata": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "labels": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Labels",
          "type": "object"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "owner": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Owner"
        },
        "version": {
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "title": "VersionedMetadata",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "const": "agents.platform/v1",
      "title": "Apiversion",
      "type": "string"
    },
    "kind": {
      "const": "Policy",
      "title": "Kind",
      "type": "string"
    },
    "metadata": {
      "$ref": "#/$defs/VersionedMetadata"
    },
    "spec": {
      "$ref": "#/$defs/PolicySpec"
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "title": "PolicyManifest",
  "type": "object"
}
